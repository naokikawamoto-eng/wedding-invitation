rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 主催者 = 合言葉を入力して admins/{uid} を作れたユーザー。主催者はどのルームも操作できる
    function isAdminUser() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isHost(roomId) {
      return isAdminUser();
    }

    // 合言葉。クライアントからは読めない。最初の 1 回だけ作成でき、変更は Firebase コンソールから行う
    match /config/admin {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['passcode'])
        && request.resource.data.passcode is string && request.resource.data.passcode.size() >= 6;
    }

    // 合言葉が一致したときだけ、自分の admins/{uid} を作れる
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['passcode'])
        && request.resource.data.passcode == get(/databases/$(database)/documents/config/admin).data.passcode;
    }

    function validNickname(data) {
      return data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 20;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if isAdminUser() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isHost(roomId);
      allow delete: if isHost(roomId);

      // 問題文・画像・選択肢。参加者は「いま出題中の 1 問」しか読めない（先読み防止）
      match /questions/{questionId} {
        allow get: if isHost(roomId)
          || (signedIn() && roomData(roomId).currentQuestionId == questionId);
        allow list, write: if isHost(roomId);
      }

      // 正解は主催者だけが読める。発表時に rooms.reveal へコピーして公開する
      match /answerKeys/{questionId} {
        allow read, write: if isHost(roomId);
      }

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nickname', 'score', 'totalTimeMs', 'joinedAt'])
          && validNickname(request.resource.data)
          && request.resource.data.score == 0
          && request.resource.data.totalTimeMs == 0
          && request.resource.data.joinedAt == request.time;
        // 本人はニックネームだけ変更可。点数は主催者だけが書ける
        allow update: if isHost(roomId)
          || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
            && validNickname(request.resource.data));
        allow delete: if isHost(roomId);
      }

      // 回答。ID は「{questionId}_{uid}」で 1 人 1 問 1 回。送信後の変更は不可
      match /answers/{answerId} {
        allow get: if isHost(roomId)
          || (signedIn() && answerId.matches('.+_' + request.auth.uid));
        allow list: if isHost(roomId);
        allow create: if signedIn()
          && answerId == request.resource.data.questionId + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['questionId', 'uid', 'nickname', 'choice', 'text', 'startedAt', 'answeredAt'])
          && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          && roomData(roomId).phase == 'question'
          && roomData(roomId).currentQuestionId == request.resource.data.questionId
          && request.resource.data.startedAt == roomData(roomId).questionStartedAt
          && request.resource.data.answeredAt == request.time;
        allow update: if false;
        allow delete: if isHost(roomId);
      }
    }
  }
}
